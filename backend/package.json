{
  "name": "@delivery-risk/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --ext .ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "node scripts/migrate.mjs up",
    "db:migrate:down": "node scripts/migrate.mjs down",
    "db:migrate:status": "node scripts/migrate.mjs status",
    "db:migrate:check": "node scripts/migrate.mjs check",
    "db:migrate:verify": "node scripts/verify-migrations.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.11",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
