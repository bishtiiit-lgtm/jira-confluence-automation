# Application runtime
NODE_ENV=development
PORT=3000
REPORT_TIMEZONE=Asia/Kolkata
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/delivery_risk_dev
PROJECT_KEYS=SAM1,KAN
JIRA_LOOKBACK_DAYS=90
UPSTREAM_TIMEOUT_MS=10000
RETENTION_REPORT_DAYS=730
RETENTION_AUDIT_DAYS=730
RETENTION_DIAGNOSTICS_DAYS=90

# Local PostgreSQL 15 Compose credentials; change only for local development
POSTGRES_DB=delivery_risk_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Optional integration settings; production requires Jira and Confluence values.
# Store actual credentials in deployment secret storage, never in this file.
JIRA_BASE_URL=
JIRA_USER_EMAIL=
JIRA_API_TOKEN=
JIRA_TEAM_IDENTIFIER=
CONFLUENCE_BASE_URL=
CONFLUENCE_SPACE_KEY=
CONFLUENCE_PAGE_ID=
CONFLUENCE_API_TOKEN=

# Optional destinations; credentials are required only when enabled.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_RECIPIENTS=
TEAMS_ENABLED=false
TEAMS_WEBHOOK_URL=

# Optional workflow metadata (workflow token is provided by GitHub Actions)
GITHUB_REPOSITORY=
GITHUB_ENVIRONMENT=
